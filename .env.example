# LeadRescue environment template
#
# Do not commit real secrets. In Bolt, add private values through the database
# Secrets settings and use them only from server functions.
#
# Vite exposes any variable prefixed with VITE_ to the browser. Only put
# public, browser-safe values behind VITE_.

# Public app config
VITE_APP_NAME=LeadRescue
VITE_PUBLIC_APP_URL=https://your-domain.example

# Server function secrets: configure in Bolt Secrets, not in browser code.
OPENAI_API_KEY=replace-in-bolt-secrets
OPENAI_MODEL=gpt-4.1-mini

TWILIO_ACCOUNT_SID=replace-in-bolt-secrets
TWILIO_AUTH_TOKEN=replace-in-bolt-secrets
TWILIO_FROM_NUMBER=replace-in-bolt-secrets

RESEND_API_KEY=replace-in-bolt-secrets
EMAIL_FROM=LeadRescue <hello@your-domain.example>

# Optional CRM/calendar/webhook providers
CRM_WEBHOOK_URL=replace-in-bolt-secrets
CRM_WEBHOOK_SECRET=replace-in-bolt-secrets
CALENDAR_PROVIDER_API_KEY=replace-in-bolt-secrets
BOOKING_WEBHOOK_SECRET=replace-in-bolt-secrets

# Payment/subscription layer for later
STRIPE_SECRET_KEY=replace-in-bolt-secrets
STRIPE_WEBHOOK_SECRET=replace-in-bolt-secrets
